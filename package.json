{
  "name": "engineering-knowledge",
  "version": "0.1.0",
  "description": "Agent-agnostic engineering knowledge repository starter",
  "main": "dist/cli.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run tests",
    "coverage:aef-002": "vitest run tests --coverage --coverage.include=src/indexing/** --coverage.include=src/validation/graph.ts --coverage.reportsDirectory=.runtime/coverage-aef-002 --coverage.thresholds.statements=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80",
    "coverage:aef-003": "vitest run tests --coverage --coverage.include=src/indexing/provenance.ts --coverage.reportsDirectory=.runtime/coverage-aef-003 --coverage.thresholds.statements=80 --coverage.thresholds.branches=80 --coverage.thresholds.functions=80 --coverage.thresholds.lines=80",
    "knowledge": "node dist/cli.js",
    "smoke:mcp": "tsx scripts/smoke-mcp.ts",
    "validate:fixtures": "tsx src/cli.ts validate",
    "index:fixtures": "tsx src/cli.ts index --full"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.31.0",
    "ajv": "8.20.0",
    "yaml": "2.9.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/node": "26.6.3",
    "@vitest/coverage-v8": "5.0.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  }
}
