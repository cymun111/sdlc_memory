# Local checkout containing this knowledge repository. Never infer from the caller's cwd.
KNOWLEDGE_ROOT=.
# Optional explicit JSON configuration (otherwise uses <root>/.runtime/config.json).
# KNOWLEDGE_CONFIG=/absolute/path/to/local-config.json
# Optional Codex executable for doctor/session commands.
# CODEX_COMMAND=/absolute/path/to/codex
# Export these values in the launching process; .env is not loaded automatically.
# Runtime storage is <root>/.runtime; owners, repositories and budgets use JSON config.
